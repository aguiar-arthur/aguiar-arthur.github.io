#!/usr/bin/env ruby
# frozen_string_literal: true

# Validates the blog content without building it. Standard library only.
#
#   ruby bin/check-content            # validate
#   ruby bin/check-content --sources  # also list documents that do not name the author of their source material
#
# Errors (exit status 1) break the build in CI: missing/invalid front matter,
# missing title/date/categories, references to files that do not exist, and
# pages/ files without an explicit permalink, upper-case or spaced file names, and git tracking a different case than the disk.
# Warnings are advisory: unknown front-matter keys, date vs. file name mismatch,
# inconsistent category/tag spelling, unreferenced assets, math without MathJax,
# images without alt text, PDFs in a group folder that are not declared, new files with a 2-digit year.
# Categories and tags outside _data/taxonomy.yml are errors.

require "yaml"
require "date"
require "time"

Dir.chdir(File.expand_path("..", __dir__))

COLLECTIONS = %w[_posts _annotations _books _papers].freeze
TAXONOMY = YAML.safe_load(File.read("_data/taxonomy.yml"), aliases: false)
# Files created before the 4-digit-year rule; they keep their names because renaming changes their URLs.
LEGACY_SHORT_DATES = File.exist?("bin/legacy-short-dates.txt") ? File.readlines("bin/legacy-short-dates.txt", chomp: true) : []
KNOWN_KEYS = %w[layout title date categories tags description lang permalink files license source license_mode].freeze
LICENSE_MODES = %w[own derived].freeze
ASSET_PATH = %r{/assets/[^\s"'<>)\]]+}.freeze

errors = []
warnings = []
missing_source = []
config = YAML.safe_load(File.read("_config.yml"), permitted_classes: [Date, Time, Symbol], aliases: false) || {}
# Front matter defaults that apply to a path (only path-scoped ones; type-scoped defaults are handled in Jekyll).
path_defaults = Array(config["defaults"]).filter_map do |d|
  scope = d["scope"] || {}
  [scope["path"], d["values"] || {}] unless scope["path"].to_s.empty?
end
referenced = []
taxonomy = { "category" => Hash.new { |h, k| h[k] = [] }, "tag" => Hash.new { |h, k| h[k] = [] } }

docs = COLLECTIONS.flat_map { |dir| Dir.glob("#{dir}/**/*.{md,markdown}") }.sort

docs.each do |file|
  raw = File.read(file, encoding: "UTF-8")
  match = raw.match(/\A---\s*\n(.*?)\n---\s*\n?(.*)\z/m)
  unless match
    errors << "#{file}: missing front matter"
    next
  end

  begin
    data = YAML.safe_load(match[1], permitted_classes: [Date, Time], aliases: false) || {}
  rescue StandardError => e
    errors << "#{file}: invalid YAML front matter (#{e.message.lines.first.strip})"
    next
  end
  body = match[2]
  group = data["layout"] == "group"

  errors << "#{file}: missing title" if data["title"].to_s.strip.empty?
  if data["date"].nil?
    errors << "#{file}: missing date"
  elsif !(data["date"].is_a?(Time) || data["date"].is_a?(Date))
    errors << "#{file}: unparsable date #{data['date'].inspect}"
  end

  unless group
    categories = data["categories"]
    if categories.nil? || Array(categories).empty?
      errors << "#{file}: missing categories"
    elsif !categories.is_a?(Array)
      warnings << "#{file}: categories should be a list (categories: [\"#{categories}\"])"
    end
  end

  errors << "#{file}: license must not be empty" if data.key?("license") && data["license"].to_s.strip.empty?
  if data.key?("license_mode") && !LICENSE_MODES.include?(data["license_mode"].to_s)
    errors << "#{file}: license_mode must be one of #{LICENSE_MODES.join(', ')}"
  end

  unless group
    effective = path_defaults.select { |path, _| file.start_with?(path.delete_prefix("/")) }.map(&:last).reduce({}, :merge).merge(data)
    if effective["source"].to_s.strip.empty? && effective["license"].to_s.strip.empty? && effective["license_mode"] != "own"
      missing_source << file
    end
  end

  # Title style: starts with a capital; in "Course - Topic" titles the topic starts with a capital too.
  title = data["title"].to_s.strip
  unless title.empty? || group
    warnings << "#{file}: title should start with an upper-case letter" if title.match?(/\A\p{Ll}/)
    _prefix, topic = title.split(" - ", 2)
    if topic
      warnings << "#{file}: title topic \"#{topic}\" should start with an upper-case letter" if topic.match?(/\A\p{Ll}/)
    end
  end

  (data.keys - KNOWN_KEYS).each { |key| warnings << "#{file}: unknown front matter key '#{key}'" }

  # Fixed vocabulary (_data/taxonomy.yml): unknown categories/tags are errors, so variants cannot creep in.
  Array(data["categories"]).each do |c|
    errors << "#{file}: category #{c.to_s.inspect} is not in _data/taxonomy.yml" unless TAXONOMY["categories"].include?(c.to_s)
  end
  Array(data["tags"]).each do |t|
    errors << "#{file}: tag #{t.to_s.inspect} is not in _data/taxonomy.yml" unless TAXONOMY["tags"].include?(t.to_s)
  end

  # New files use a 4-digit year (2026-03-22-slug.md); older 2-digit names are grandfathered.
  if File.basename(file).match?(/\A\d{2}-\d\d-\d\d-/) && !LEGACY_SHORT_DATES.include?(file)
    warnings << "#{file}: file name should start with a 4-digit year (YYYY-MM-DD-)"
  end

  Array(data["categories"]).each { |c| taxonomy["category"][c.to_s.downcase] << c.to_s }
  Array(data["tags"]).each { |t| taxonomy["tag"][t.to_s.downcase] << t.to_s }

  # Compare the date as written: YAML converts zone-less times to the machine's time zone,
  # which would move 00:00-02:59 to the previous day in UTC-3.
  written = match[1][/^date:\s*["']?(\d{4})-(\d\d)-(\d\d)/, 0]&.scan(/\d+/)
  if (name = File.basename(file).match(/\A(\d{2,4})-(\d\d)-(\d\d)-/)) && written
    year = name[1].length == 2 ? "20#{name[1]}" : name[1]
    unless [year, name[2], name[3]] == written.first(3)
      warnings << "#{file}: date #{written.first(3).join('-')} differs from the file name"
    end
  end

  (body + match[1]).scan(ASSET_PATH).each do |path|
    path = path.sub(/[.,;]+\z/, "")
    referenced << path
    errors << "#{file}: references missing file #{path}" unless File.exist?(path.delete_prefix("/"))
  end

  if group
    declared = []
    Array(data["files"]).each do |entry|
      if entry.is_a?(Hash) && entry.key?("divider")
        errors << "#{file}: empty divider in files" if entry["divider"].to_s.strip.empty?
        next
      end
      name = entry.is_a?(Hash) ? entry["file"] : entry
      if name.to_s.strip.empty?
        errors << "#{file}: files entry #{entry.inspect} needs a file or a divider"
        next
      end
      path = name.to_s.start_with?("/") ? name.delete_prefix("/") : File.join(File.dirname(file), name.to_s)
      declared << File.expand_path(path)
      errors << "#{file}: declared document #{name} does not exist" unless File.exist?(path)
    end
    Dir.glob(File.join(File.dirname(file), "*.pdf")).each do |pdf|
      warnings << "#{pdf}: not declared in #{file} (it will not be listed)" unless declared.include?(File.expand_path(pdf))
    end
  else
    math = body.match?(/\$\$|\\\(|\\\[/)
    include_mathjax = body.include?("mathjax.html")
    warnings << "#{file}: uses math but does not include mathjax.html" if math && !include_mathjax
    warnings << "#{file}: includes mathjax.html but has no math" if include_mathjax && !math
    warnings << "#{file}: <img> without alt text" if body.match?(/<img(?![^>]*\balt=)[^>]*>/)
  end
end

# Standalone pages live in pages/; their URL must be explicit so moving the file never changes it.
Dir.glob("pages/**/*.{html,md,markdown}").sort.each do |page|
  front = File.read(page, encoding: "UTF-8")[/\A---\s*\n(.*?)\n---/m, 1]
  data = front && (YAML.safe_load(front, permitted_classes: [Date, Time], aliases: false) || {})
  if data.nil?
    errors << "#{page}: missing front matter"
  elsif data["permalink"].to_s.strip.empty?
    errors << "#{page}: pages/ files must declare a permalink"
  end
end

# A page URL must not collide with a root file that Jekyll copies to _site/, ignoring case: on macOS (case-insensitive)
# `/license/` and `LICENSE` end up fighting over the same path and the build fails with EPERM.
excluded = Array(config["exclude"]).map { |e| e.to_s.sub(%r{/\z}, "").sub(/\s+#.*/, "") }
root_names = Dir.children(".").reject { |n| n.start_with?("_", ".") || excluded.include?(n) }
Dir.glob("pages/**/*.{html,md,markdown}").sort.each do |page|
  front = File.read(page, encoding: "UTF-8")[/\A---\s*\n(.*?)\n---/m, 1]
  permalink = front && (YAML.safe_load(front, permitted_classes: [Date, Time], aliases: false) || {})["permalink"]
  segment = permalink.to_s.split("/").reject(&:empty?).first.to_s.sub(/\..*\z/, "")
  next if segment.empty?

  clash = root_names.find { |n| n.sub(/\..*\z/, "").casecmp?(segment) }
  errors << "#{page}: URL #{permalink} collides with root file #{clash} (case-insensitive filesystems); exclude it in _config.yml or change the permalink" if clash
end

# File names: lowercase, no spaces. Names are part of the URL, and Linux (CI, GitHub Pages) is case-sensitive
# while macOS is not, so `Foo.pdf` can work locally and break in production.
NAME_DIRS = %w[_annotations _posts _books _papers pages assets].freeze
disk_paths = NAME_DIRS.flat_map { |dir| Dir.glob("#{dir}/**/*", File::FNM_DOTMATCH) }
                      .select { |p| File.file?(p) && !File.basename(p).start_with?(".") && !p.include?("/.") }
disk_paths.sort.each do |path|
  bad = path.split("/").drop(1).any? { |part| part.match?(/[A-Z\s]/) }
  errors << "#{path}: file and folder names must be lowercase without spaces (they become URLs)" if bad
end

# The git index must use the same case as the disk. On macOS a case-only rename is invisible to git, so the
# repository keeps the old name and CI (Linux) fails to find the file.
if File.directory?(".git") && system("git --version > /dev/null 2>&1")
  tracked = `git ls-files -z -- #{NAME_DIRS.join(' ')}`.split("\0")
  real = disk_paths.to_h { |p| [p.downcase, p] }
  tracked.each do |path|
    actual = real[path.downcase]
    next if actual.nil? || actual == path

    errors << "#{path}: git tracks a different case than the disk (#{actual}); run: git mv -f '#{path}' '#{actual}'"
  end
end

# Spelling variants of the same category/tag (case-insensitive duplicates).
taxonomy.each do |kind, groups|
  groups.each_value do |spellings|
    variants = spellings.uniq
    warnings << "#{kind} spelled inconsistently: #{variants.map(&:inspect).join(', ')}" if variants.size > 1
  end
end

# Assets that no document, layout or include points to.
(Dir.glob("_layouts/*") + Dir.glob("_includes/*")).each { |f| referenced.concat(File.read(f).scan(ASSET_PATH)) }
Dir.glob("assets/{pdfs,images}/**/*").select { |f| File.file?(f) }.each do |asset|
  warnings << "#{asset}: not referenced anywhere" unless referenced.include?("/#{asset}")
end

if ARGV.include?("--sources")
  puts "Documents without a `source` (author of the material they are based on):"
  missing_source.group_by { |f| File.dirname(f) }.each do |dir, files|
    puts "  #{dir}/ (#{files.size})"
  end
  puts "  all documents name a source" if missing_source.empty?
  puts
end

warnings.each { |w| puts "warning: #{w}" }
errors.each { |e| puts "error:   #{e}" }
puts "#{docs.size} documents checked: #{errors.size} error(s), #{warnings.size} warning(s)"
exit(errors.empty? ? 0 : 1)
